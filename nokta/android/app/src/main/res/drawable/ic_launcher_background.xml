<?xml version="1.0" encoding="utf-8"?>
<!-- The plate behind the adaptive icon: the brand gradient rather than a flat
     fill, so whatever mask the launcher applies shows the same face as the
     legacy icon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:startColor="#FFA040"
        android:endColor="#EA580C"
        android:angle="315"
        android:type="linear"/>
</shape>
